# ==============================================================
# Pontora Outreach — Environment Configuration
# Copy this file to .env and fill in real values. Never commit .env.
# ==============================================================

# --- Anthropic API ---
# Get from: https://console.anthropic.com/settings/keys
# Requires ~$5-10 top-up to start. Does NOT use your Pro subscription.
ANTHROPIC_API_KEY=

# --- Google Cloud: Places API ---
# Get from: https://console.cloud.google.com/apis/credentials
# Enable "Places API (New)" in your Google Cloud project.
# Free $200/month credit auto-applied. Restrict key to Places API + your IP.
GOOGLE_PLACES_API_KEY=

# --- Google Cloud: Sheets API ---
# Service account JSON file. See docs/setup_google.md
GOOGLE_SHEETS_CREDENTIALS_PATH=./config/google-service-account.json
GOOGLE_SHEET_ID=

# --- Brand / outreach mailbox ---
BRAND_NAME=Pontora
PRODUCT_DOMAIN=mypontora.com
PRODUCT_URL=https://mypontora.com
DEMO_URL=https://mypontora.com/demo
OUTREACH_EMAIL=ketan@mypontora.com
SUMMARY_EMAIL_TO=kg.ketan@gmail.com
OUTREACH_ADMIN_URL=https://enrollify-admin.onrender.com

# --- Gmail OAuth ---
# Download OAuth Desktop client JSON from Google Cloud to this path, then run:
#   python scripts/setup_gmail_oauth.py
GMAIL_OAUTH_CLIENT_PATH=./config/gmail-oauth-client.json
GMAIL_TOKEN_PATH=./config/gmail-token.json

# --- Pushover (Phase 6) ---
# One-time $5 app purchase. Get keys from: https://pushover.net/
PUSHOVER_USER_KEY=
PUSHOVER_APP_TOKEN=

# --- Project config ---
DEFAULT_DAILY_EMAIL_CAP=20
WORKING_HOURS_START=9
WORKING_HOURS_END=17
TIMEZONE=America/Los_Angeles
HOME_ZIP=90045
